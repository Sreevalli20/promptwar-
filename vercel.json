{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "env": {
    "GROQ_API_KEY": "@groq-api-key",
    "HF_TOKEN": "@hf-token",
    "HF_MODEL": "meta-llama/Llama-3.3-70B-Instruct",
    "GROQ_MODEL": "openai/gpt-oss-120b",
    "AI_PRIMARY_PROVIDER": "groq",
    "AI_FALLBACK_PROVIDER": "huggingface"
  }
}